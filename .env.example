# Connect ChatGPT or save an OpenAI API key in Settings before running agents.
# Environment credentials are optional if you connect through Settings.
JELLY_PORT=3100
JELLY_DATA_DIR=.jelly
# User-wide configuration, shared across Jelly instances and projects.
# JELLY_CONFIG_DIR=/home/you/.jelly
# OPENAI_API_KEY=
# Firecrawl powers the agent's web_search and web_fetch tools.
# FIRECRAWL_API_KEY=
# Shared server-wide pacing (default 10 requests/minute, safe for free scrape plans).
# Raise to match the Firecrawl account's rate allowance, not above it.
# FIRECRAWL_REQUESTS_PER_MINUTE=10
# JELLY_AUTH_FILE=.jelly/auth.json
# JELLY_BROWSER_PATH=/usr/bin/google-chrome

# API auto-reload is enabled by default; backend edits interrupt active runs.
# Set to 0 to disable it. Client hot reload stays enabled either way.
# JELLY_WATCH_API=0

# Enable an HTTP dev listener on this computer's Tailscale addresses.
# JELLY_TAILSCALE=1
# Extra exact origins for a separately configured local reverse proxy:
# JELLY_PUBLIC_ORIGINS=http://your-machine.your-tailnet.ts.net:5173
