# Connect ChatGPT, use a Claude Code subscription login, or save an OpenAI API key.
# Environment credentials are optional if you connect through Settings.
# Claude Code owns its own login; select the Claude provider explicitly in Settings.
# macOS: use a user LaunchAgent in your GUI login/Keychain session, not a system
# LaunchDaemon even if its UserName matches yours. See docs/MACOS.md.
# Launchd does not load shell startup files. Use your actual absolute CLI path:
# PI_CLAUDE_CODE_COMMAND=/Users/you/.local/bin/claude
# Only set this if Claude intentionally uses a nondefault config directory:
# PI_CLAUDE_CODE_CONFIG_DIR=/Users/you/.claude-custom
# Restart after environment changes, then refresh Claude in Settings.
# Never put Claude OAuth tokens here or copy them into Jelly's auth files.
JELLY_PORT=3100
JELLY_DATA_DIR=.jelly
# User-wide configuration, shared across Jelly instances and projects.
# JELLY_CONFIG_DIR=/home/you/.jelly
# OPENAI_API_KEY=
# Firecrawl powers the agent's web_search and web_fetch tools.
# FIRECRAWL_API_KEY=
# Shared server-wide pacing (default 10 requests/minute, safe for free scrape plans).
# Raise to match the Firecrawl account's rate allowance, not above it.
# FIRECRAWL_REQUESTS_PER_MINUTE=10
# JELLY_AUTH_FILE=.jelly/auth.json
# Parent model status checkpoints while delegated work is active (milliseconds).
# Default five minutes; accepted range 1000–3600000. Cannot preempt an open tool.
# JELLY_SUBAGENT_HEARTBEAT_MS=300000

# API auto-reload is enabled by default; backend edits interrupt active runs.
# Set to 0 to disable it. Client hot reload stays enabled either way.
# JELLY_WATCH_API=0

# Enable native HTTP listeners on this computer's discovered Tailscale addresses.
# Production: shared Bun handlers; dev: Vite listeners plus loopback API proxy.
# JELLY_TAILSCALE=1
# Extra exact origins for a separately configured local reverse proxy:
# JELLY_PUBLIC_ORIGINS=http://your-machine.your-tailnet.ts.net:5173
