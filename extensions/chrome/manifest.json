{
  "manifest_version": 3,
  "name": "Jelly Connected Chrome (experimental)",
  "version": "0.4.0",
  "key": "",
  "description": "Jelly task tabs with access to all websites, including local/private services. Not a browser sandbox.",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "scripting",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html" }
}
