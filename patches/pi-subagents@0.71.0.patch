+/**
+ * A terminal, owner-scoped factory. Shutdown closes admission before disposing
+ * live children and drains launches already in flight, including placement.
+ * A late-created child is never returned to its executor after owner shutdown.
+ */
+export function createOwnedChildSessionFactory(factory = createPlacementChildSessionFactory()) {
+    let closed = false;
+    let disposal;
+    const pending = new Set();
+    const shutdownError = () => new Error("Subagent stopped because the parent session shut down.");
+    return {
+        create(launch) {
+            if (closed)
+                return Promise.reject(shutdownError());
+            const creation = Promise.resolve().then(() => {
+                if (closed)
+                    throw shutdownError();
+                return factory.create(launch);
+            }).then(async (child) => {
+                if (!closed)
+                    return child;
+                child.shutDown = true;
+                try {
+                    await child.abort();
+                }
+                finally {
+                    await child.dispose();
+                }
+                throw shutdownError();
+            });
+            pending.add(creation);
+            void creation.then(() => pending.delete(creation), () => pending.delete(creation));
+            return creation;
+        },
+        dispose() {
+            closed = true;
+            disposal ??= (async () => {
+                try {
+                    await factory.dispose();
+                }
+                finally {
+                    await Promise.allSettled([...pending]);
+                }
+            })();
+            return disposal;
+        },
+    };
